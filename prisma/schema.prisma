datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                String            @id @default(cuid())
  name              String?
  username          String?           @unique
  email             String?           @unique
  emailVerified     DateTime?
  image             String?
  bio               String?
  twitchUsername    String?
  statsHoursWatched Float             @default(0)
  statsRoomsCreated Int               @default(0)
  statsRoomsJoined  Int               @default(0)
  accounts          Account[]
  sessions          Session[]
  friends           Friendship[]      @relation("UserFriends")
  friendOf          Friendship[]      @relation("UserFriendOf")
  hostedRooms       Room[]            @relation("UserHostedRooms")
  roomsJoined       RoomParticipant[]
  roomMessages      RoomMessage[]
  followedChannels  FollowedChannel[]
  watchHistory      WatchHistory[]
  createdAt         DateTime          @default(now())
}

model Room {
  id              String            @id @default(cuid())
  code            String            @unique
  name            String            @default("Watch Party")
  platform        String            @default("twitch")
  streamUrl       String?
  channel         String?
  category        String            @default("Entretenimiento")
  description     String?
  isPrivate       Boolean           @default(false)
  password        String?
  maxParticipants   Int               @default(10)
  communicationMode String            @default("FLEXIBLE")
  allowVoice        Boolean           @default(true)
  allowVideo        Boolean           @default(true)
  isClosed          Boolean           @default(false)
  hostId            String?
  host              User?             @relation("UserHostedRooms", fields: [hostId], references: [id], onDelete: SetNull)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  participants      RoomParticipant[]
  messages          RoomMessage[]
}

model RoomParticipant {
  id            String   @id @default(cuid())
  roomId        String
  userId        String?
  connectionId  String   @unique
  name          String   @default("Invitado")
  avatar        String?
  role          String   @default("MEMBER")
  isMuted       Boolean  @default(true)
  cameraEnabled Boolean  @default(false)
  isSpeaking    Boolean  @default(false)
  handRaised    Boolean  @default(false)
  lastSeenAt    DateTime @default(now())
  joinedAt      DateTime @default(now())

  room Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId, lastSeenAt])
}

model RoomMessage {
  id        String   @id @default(cuid())
  roomId    String
  userId    String?
  sender    String
  avatar    String?
  text      String
  isHost    Boolean  @default(false)
  createdAt DateTime @default(now())

  room Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([roomId, createdAt])
}

model FollowedChannel {
  id           String   @id @default(cuid())
  userId       String
  platform     String
  channelId    String
  displayName  String
  avatarUrl    String?
  category     String?
  isLive       Boolean  @default(false)
  url          String?
  lastSyncedAt DateTime @default(now()) @updatedAt
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform, channelId])
}

model WatchHistory {
  id              String   @id @default(cuid())
  userId          String
  roomCode        String
  roomName        String
  platform        String
  channel         String
  durationMinutes Int      @default(0)
  joinedAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Friendship {
  id        String   @id @default(cuid())
  userId    String
  friendId  String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())

  user   User @relation("UserFriends", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("UserFriendOf", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model RoomSignal {
  id                 String   @id @default(cuid())
  roomId             String
  senderConnectionId String
  targetConnectionId String
  type               String
  payload            String   @db.Text
  createdAt          DateTime @default(now())

  @@index([roomId, targetConnectionId, createdAt])
}

